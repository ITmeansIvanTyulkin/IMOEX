<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.moex</groupId>
        <artifactId>trinity</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>trinity-trend</artifactId>
    <name>trinity-trend</name>
    <description>Strategy 2 — trend trading robot playbooks (sandbox-first)</description>

    <dependencies>
        <dependency>
            <groupId>com.moex</groupId>
            <artifactId>trinity-shared</artifactId>
        </dependency>
        <dependency>
            <groupId>com.moex</groupId>
            <artifactId>trinity-marketdata</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>com.moex.trinity.trend.replay.BrM5DayReplay</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
